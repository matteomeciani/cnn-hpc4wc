# Build artefacts
build/*
!build/.gitkeep
core_*

# Logs
logs/*

# Model weights
**/*.pth

# Binary files
**/*.bin

# Object files
*.o

# save trained python weights for comparability (but not the cpp logits)
!src/python/weights_cpp/model*.bin

# Python bytecode cache
__pycache__/
*.pyc

# Generated benchmark timing (see benchmark.cpp / benchmark.py)
src/python/weights_cpp/cpp_timing.json
